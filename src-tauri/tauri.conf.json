{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dashcam Card Scanner",
  "version": "0.1.3",
  "identifier": "com.vortexradar.cardscanner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dashcam Card Scanner",
        "width": 1000,
        "height": 850,
        "minWidth": 700,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    },
    "shortDescription": "Privacy-first read-only dashcam card research scanner",
    "copyright": "Copyright 2026 Vortex Radar"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNDNUI0RURFRTUxMkNFN0UKUldSK3poTGwzazViUEllU0wrUzdVY2VCUWduSWh4WGlBeW41STR1KzhvRCsyN0o5MlNDNm4vWEkK",
      "endpoints": [
        "https://github.com/vortexopenclaw/dashcam-card-scanner/releases/latest/download/latest.json"
      ]
    }
  }
}