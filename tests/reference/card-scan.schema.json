{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vortexopenclaw/dashcam-camera-profiles/blob/main/schemas/card-scan.schema.json",
  "title": "Dashcam Card Scan",
  "description": "A public, sanitized description of a dashcam card. It must not contain media, original names, identifiers, or location data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "camera", "evidence", "card_layout"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manufacturer", "model", "channel_setup"],
      "properties": {
        "manufacturer": { "type": "string", "minLength": 1, "maxLength": 100 },
        "model": { "type": "string", "minLength": 1, "maxLength": 100 },
        "channel_setup": { "type": "string", "minLength": 1, "maxLength": 200 },
        "firmware": { "type": "string", "maxLength": 100 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["card-validated", "manual-backed", "catalog-hint"] },
        "sources": {
          "type": "array",
          "items": { "type": "string", "format": "uri" },
          "maxItems": 10
        },
        "notes": { "type": "string", "maxLength": 2000 }
      }
    },
    "card_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["folders"],
      "properties": {
        "folders": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/folder" }
        },
        "safe_model_markers": {
          "type": "array",
          "items": { "type": "string", "maxLength": 200 },
          "maxItems": 10
        }
      }
    },
    "notes": { "type": "string", "maxLength": 2000 }
  },
  "$defs": {
    "folder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_count"],
      "properties": {
        "path": { "type": "string", "pattern": "^[^/].{0,199}$" },
        "file_count": { "type": "integer", "minimum": 0 },
        "extensions": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "filename_patterns": {
          "type": "array",
          "items": { "$ref": "#/$defs/pattern" },
          "maxItems": 20
        },
        "video_summary": { "$ref": "#/$defs/video" }
      }
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern"],
      "properties": {
        "pattern": { "type": "string", "maxLength": 300 },
        "channel": { "enum": ["front", "rear", "interior", "telephoto", "left", "right", "unknown"] },
        "recording_mode": { "type": "string", "maxLength": 100 }
      }
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "codec": { "type": "string", "maxLength": 100 },
        "resolution": { "type": "string", "pattern": "^[0-9]{2,5}x[0-9]{2,5}$" },
        "frame_rate": { "type": "number", "minimum": 1, "maximum": 240 },
        "bitrate_range_mbps": {
          "type": "array",
          "items": { "type": "number", "minimum": 0 },
          "minItems": 2,
          "maxItems": 2
        }
      }
    }
  }
}
